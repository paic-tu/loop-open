# ======================================================
#  أوبن لوب | Open Loop — Environment Variables Template
#  انسخ هذا الملف إلى .env محلياً واملأ القيم
#  أو انسخ القيم إلى Vercel Project Settings → Environment Variables
# ======================================================

# ===== Supabase Project (الخانة الوحيدة المطلوبة إلزامياً) =====
# Project ID Example:  berprxhuguniggtnerfq
SUPABASE_PROJECT_ID="your-supabase-project-id-here"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-public-key-starts-with-eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-starts-with-eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9"

# ===== Vite client-side mirrors (نفس القيم السابقة لكن ببادئة VITE_) =====
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id-here"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-public-key-starts-with-eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9"

# ===== Vercel Production (حل سريع لو ظهرت لك رسالة Aww Snap في أول عرض) =====
# هذا المتغير يُحل رسالة "This page didn't load" في حالة غياب مفاتيح Supabase
# (مفيد أثناء الإعداد الأولي فقط — يمكنك حذفه بعد إكمال الإعداد):
# VERCEL_SKIP_SSR_AUTH_BOOTSTRAP=1

# ===== Vercel TanStack Security Override (حل طارئ فقط) =====
# استخدمه فقط لو ظهرت لك رسالة "Vulnerable TanStack Start package detected"
# بعد ترقية الحزم. بشكل عام بعد الترقية لا تحتاجه:
# DANGEROUSLY_DEPLOY_VULNERABLE_TANSTACK_START_XSS=1
